# Copy to .env for local development:  cp .env.example .env
#
# A deployed application gets CTP_* from the Connect deployment, which
# generates the API Client. These are for running the app on your machine.
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_PROJECT_KEY=
CTP_SCOPE=
CTP_REGION=

# Resend. Unset RESEND_API_KEY and the mail-sender still runs end to end:
# every message is rendered and recorded on the Custom Object, none is sent.
RESEND_API_KEY=
ABANDONED_CART_FROM=
# Set this and every email goes to that one address instead of the shopper's.
ABANDONED_CART_REDIRECT_ALL_TO=
